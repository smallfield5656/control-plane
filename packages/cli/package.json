{
  "name": "@smallfield5656/control-plane",
  "version": "0.2.4",
  "description": "A lightweight engineering control plane for AI-assisted software projects.",
  "type": "module",
  "bin": {
    "control-plane": "dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smallfield5656/control-plane.git"
  },
  "bugs": {
    "url": "https://github.com/smallfield5656/control-plane/issues"
  },
  "homepage": "https://github.com/smallfield5656/control-plane#readme",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "engineering",
    "control-plane"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run stage-template",
    "stage-template": "node scripts/stage-template.mjs",
    "clean-template": "node scripts/clean-template.mjs",
    "prepack": "npm run build",
    "postpack": "npm run clean-template",
    "test": "npm run build && node --test tests/init.test.mjs tests/doctor.test.mjs tests/bootstrap.test.mjs tests/check.test.mjs tests/output.test.mjs tests/validation.test.mjs tests/stage-template.test.mjs tests/package.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
